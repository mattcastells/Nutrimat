<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Necesario para el catálogo de alimentos (Open Food Facts) y, más
         adelante, para Supabase. En debug Flutter lo agrega solo; en release
         no, así que sin esta línea la app compila y no tiene red. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Nutrimat se distribuye fuera de Play Store: Configuración →
         Actualizaciones descarga el APK del release de GitHub y se lo entrega
         al instalador de paquetes del sistema, que es quien pide la
         confirmación final. Sin este permiso el instalador ni se abre.

         ⚠️ Si algún día la app va a Play Store, este permiso hay que sacarlo
         junto con la descarga: Google lo rechaza salvo para gestores de
         paquetes, y el updater tendría que limitarse a avisar. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Lectura de códigos de barras. La foto de comida no la necesita: usa el
         intent de cámara del sistema, que no exige permiso. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Alguna dependencia puede declarar permisos de lectura de la galería
         porque su caso de uso general es abrir archivos del almacenamiento
         compartido. Nutrimat no lee nada de ahí: el APK de la actualización lo
         escribe en su propio directorio privado y las fotos las trae el
         selector del sistema, que no exige permiso.

         Se quitan del manifest final: pedir acceso a las fotos, los videos y
         el audio de alguien "por las dudas" contradice todo lo que la pantalla
         de Privacidad le promete. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>

    <application
        android:label="Nutrimat"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Esquema propio reservado (02-information-architecture.md §6).
                 Los App Links verificados quedan para la fase 15: necesitan un
                 dominio con assetlinks.json publicado. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nutrimat"/>
            </intent-filter>
        </activity>
        <!-- Le pasa al instalador de paquetes una URI `content://` del APK
             recién descargado. Un `file://` haría que Android lance
             FileExposedException desde API 24; el provider concede lectura
             solo sobre ese archivo y solo mientras dura el intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nm_update_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
