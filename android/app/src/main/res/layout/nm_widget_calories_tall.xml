<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de calorías, **4×2 · 340 × 150 dp**. §3.4 del rediseño.

     El único tamaño donde el mínimo táctil entra de verdad: las ocho gotas
     vuelven a ser tocables una por una, como siempre fueron, pero ahora con área
     suficiente.

     **La cuenta de agua va arriba y no al final de las gotas**: 320 dp de ancho
     útil menos las cajas de las gotas no dejan lugar para "1 de 6 vasos" al lado,
     y las cajas son la única razón de que este tamaño exista.

     Alto: 150 − 20 de padding = 130 dp; la pila mide 128 (43 del bloque del
     número + 5 de la barra + 20 de los macros + 48 de las gotas + 3 gaps de 4).
     Por eso el número es 28 sp y no 32: con 32 la fila de gotas se sale de la
     tarjeta y lo primero que se pierde es la barra del día.

     **Desvío del diseño, a propósito.** La especificación pide cajas de 48 dp
     fijas y bajarlas a 40 cuando la meta llega a 7 (`setViewLayoutWidth`, solo
     API 31+). Acá las cajas van con `weight`, que da lo mismo sin código y en
     todas las versiones: `LinearLayout` saltea por completo a los hijos en `gone`
     —no cuentan para el reparto—, así que seis gotas visibles se llevan 53 dp
     cada una y ocho se llevan 40, que es exactamente lo que pedía la regla. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nm_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nm_widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/nm_widget_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Fila 1: el número, y a la derecha lo que no entra en otro lado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nm_widget_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="28sp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/nm_widget_accent"/>

                <TextView
                    android:id="@+id/nm_widget_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nm_widget_calories_label"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="end">

                <!-- Vuelve el "1.714 de 2.810" que se había sacado del tamaño
                     chico: acá hay lugar y no le quita la línea a nadie. -->
                <TextView
                    android:id="@+id/nm_widget_intake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text_muted"/>

                <TextView
                    android:id="@+id/nm_widget_water_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/nm_widget_text_muted"/>

                <TextView
                    android:id="@+id/nm_widget_extra_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text_muted"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Fila 2: la barra del día ─────────────────────────────────── -->
        <ProgressBar
            android:id="@+id/nm_widget_calories_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:minHeight="5dp"
            android:maxHeight="5dp"
            android:max="100"
            android:progressDrawable="@drawable/nm_widget_bar_calories"/>

        <!-- ── Fila 3: los macros, en columnas ──────────────────────────── -->
        <LinearLayout
            android:id="@+id/nm_widget_macros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nm_widget_protein_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text_muted"/>
                <ProgressBar
                    android:id="@+id/nm_widget_protein_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:minHeight="5dp"
                    android:maxHeight="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/nm_widget_bar_protein"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nm_widget_carbs_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text_muted"/>
                <ProgressBar
                    android:id="@+id/nm_widget_carbs_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:minHeight="5dp"
                    android:maxHeight="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/nm_widget_bar_carbs"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nm_widget_fat_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/nm_widget_text_muted"/>
                <ProgressBar
                    android:id="@+id/nm_widget_fat_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:minHeight="5dp"
                    android:maxHeight="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/nm_widget_bar_fat"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Fila 4: las ocho gotas, tocables una por una ─────────────── -->
        <!-- Se queda con el alto sobrante (`weight`) y no con 48 dp fijos: este
             tamaño se puede estirar hasta 200 dp, y con alto fijo los 50 dp de
             más quedaban en aire abajo — el mismo agujero que se vino
             arreglando. Acá el sobrante engorda lo único que se toca, que es
             justo donde más sirve. El piso son 48 dp. -->
        <LinearLayout
            android:id="@+id/nm_widget_water_pill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/nm_widget_drop_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:adjustViewBounds="false" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
            <ImageView android:id="@+id/nm_widget_drop_8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="centerInside" android:maxWidth="22dp" android:maxHeight="22dp" android:src="@drawable/nm_widget_drop_empty" android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Los otros dos extras no entran acá: la racha ya está arriba. -->
        <LinearLayout
            android:id="@+id/nm_widget_extras"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/nm_widget_extra_activity" android:layout_width="0dp" android:layout_height="0dp"/>
            <TextView android:id="@+id/nm_widget_extra_sleep" android:layout_width="0dp" android:layout_height="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/nm_widget_empty"/>
</FrameLayout>
